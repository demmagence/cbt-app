rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    function role(value) {
      return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == value;
    }
    function ownsExam(examId) {
      return role('guru') && get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid;
    }
    function isValidExam(data) {
      return data.keys().hasOnly(['id', 'title', 'description', 'code', 'createdBy', 'duration', 'startDate', 'endDate', 'isActive', 'shuffleQuestions', 'shuffleOptions', 'totalQuestions', 'locked']) &&
             data.keys().hasAll(['id', 'title', 'description', 'code', 'createdBy', 'duration', 'startDate', 'endDate', 'isActive', 'shuffleQuestions', 'shuffleOptions', 'totalQuestions']) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 20 &&
             data.createdBy is string && data.createdBy.size() >= 20 && data.createdBy.size() <= 128 &&
             data.duration is int && data.duration > 0 && data.duration <= 1440 &&
             data.startDate is timestamp &&
             data.endDate is timestamp &&
             data.startDate < data.endDate &&
             data.isActive is bool &&
             data.shuffleQuestions is bool &&
             data.shuffleOptions is bool &&
             data.totalQuestions is int && data.totalQuestions >= 0 && data.totalQuestions <= 100;
    }

    function isValidQuestionBankItem(data) {
      let hasAllRequired = data.keys().hasAll(['id', 'type', 'text', 'maxScore', 'order', 'points', 'createdBy']);
      let hasOnlyAllowed = data.keys().hasOnly(['id', 'type', 'text', 'options', 'correctAnswer', 'essayGuideline', 'maxScore', 'order', 'points', 'createdBy']);
      
      return hasAllRequired && hasOnlyAllowed &&
             data.createdBy is string && data.createdBy.size() >= 20 && data.createdBy.size() <= 128 &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.type in ['pg', 'essay'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.maxScore is number && data.maxScore > 0 && data.maxScore <= 10000 &&
             data.order is int && data.order >= 0 && data.order <= 10000 &&
             data.points is number && data.points > 0 && data.points <= 10000 &&
             (data.type == 'pg' ? 
                (data.keys().hasAll(['options', 'correctAnswer']) && 
                 data.options is list && data.options.size() >= 2 && data.options.size() <= 10 &&
                 validOptions(data.options) &&
                 data.correctAnswer is int && data.correctAnswer >= 0 && data.correctAnswer < data.options.size()) : 
                (!('options' in data) && !('correctAnswer' in data))) &&
             (!('essayGuideline' in data) || (data.essayGuideline is string && data.essayGuideline.size() <= 2000));
    }

    function validOptionAt(options, index) {
      return options.size() <= index ||
        (options[index] is string && options[index].size() >= 1 && options[index].size() <= 2000);
    }

    function validOptions(options) {
      return validOptionAt(options, 0) && validOptionAt(options, 1) &&
        validOptionAt(options, 2) && validOptionAt(options, 3) &&
        validOptionAt(options, 4) && validOptionAt(options, 5) &&
        validOptionAt(options, 6) && validOptionAt(options, 7) &&
        validOptionAt(options, 8) && validOptionAt(options, 9);
    }


    // Privileged writes use authenticated callable functions (Admin SDK).
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || role('admin') ||
        (role('guru') && resource.data.role == 'siswa');
      allow write: if false;
    }
    match /exams/{examId} {
      allow read: if role('admin') || (role('guru') && resource.data.createdBy == request.auth.uid) ||
        (role('siswa') && (resource.data.isActive ||
          exists(/databases/$(database)/documents/exam_sessions/$(request.auth.uid + '_' + examId))));
      allow create, delete: if false;
      allow update: if ownsExam(examId) && isValidExam(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'code', 'createdBy', 'totalQuestions', 'locked']) &&
        (!resource.data.get('locked', false) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])) &&
        (!request.resource.data.isActive || request.resource.data.totalQuestions > 0);
    }
    // Question documents contain answer keys and must never be readable by students.
    match /exams/{examId}/questions/{questionId} {
      allow read: if role('admin') || ownsExam(examId);
      allow write: if false;
    }
    match /exam_sessions/{sessionId} {
      allow read: if role('admin') || ownsExam(resource.data.examId) ||
        (role('siswa') && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /exam_results/{resultId} {
      allow read: if role('admin') || ownsExam(resource.data.examId) ||
        (role('siswa') && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /session_content/{sessionId} {
      allow read: if role('admin') || ownsExam(resource.data.examId);
      allow write: if false;
    }
    match /question_bank/{questionId} {
      allow read: if role('admin') || (role('guru') && resource.data.createdBy == request.auth.uid);
      allow create: if role('guru') && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.id == questionId && isValidQuestionBankItem(request.resource.data);
      allow update: if role('guru') && resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy && request.resource.data.id == questionId &&
        isValidQuestionBankItem(request.resource.data);
      allow delete: if role('guru') && resource.data.createdBy == request.auth.uid;
    }
  }
}
